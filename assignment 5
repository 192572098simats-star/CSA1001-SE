import { useEffect, useState } from "react";

function Dashboard() {
    const [sales, setSales] = useState([]);

    useEffect(() => {
        fetch("http://localhost:5000/api/sales")
            .then(response => response.json())
            .then(data => setSales(data))
            .catch(error => console.error(error));
    }, []);

    return (
        <div>
